SELECT Address,
       COUNT(StudentId) AS N'SoLuongHocVien'
FROM Student
GROUP BY Address;

-- 2. Tính điểm trung bình của từng sinh viên
SELECT 
    S.StudentId,
    S.StudentName,
    AVG(M.Mark) AS DiemTrungBinh
FROM Student S
JOIN Mark M
    ON S.StudentId = M.StudentId
GROUP BY 
    S.StudentId,
    S.StudentName;

-- 3. Hiển thị sinh viên có điểm trung bình lớn hơn 15 (nếu có)
SELECT 
    S.StudentId,
    S.StudentName,
    AVG(M.Mark) AS DiemTrungBinh
FROM Student S
JOIN Mark M
    ON S.StudentId = M.StudentId
GROUP BY 
    S.StudentId,
    S.StudentName
HAVING AVG(M.Mark) > 15;

-- 4. Hiển thị sinh viên có điểm trung bình lớn nhất/cao nhất bằng hàm ALL
SELECT 
    S.StudentId,
    S.StudentName,
    AVG(M.Mark) AS DiemTrungBinh
FROM Student S
JOIN Mark M
    ON S.StudentId = M.StudentId
GROUP BY 
    S.StudentId,
    S.StudentName
HAVING AVG(M.Mark) >= ALL
(
